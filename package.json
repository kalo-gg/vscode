{
  "name": "kalo-projects",
  "displayName": "Kalo Projects",
  "description": "Do Kalo course projects in your editor: opens a lesson's starter files, and sends your work back to your kalo.gg account.",
  "version": "0.2.0",
  "publisher": "ryancundiff",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/kalo-gg/vscode.git" },
  "homepage": "https://kalo.gg",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Education", "Other"],
  "keywords": ["luau", "roblox", "jecs", "kalo"],
  "activationEvents": ["onUri", "onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      { "command": "kalo.openProject", "title": "Kalo: Open a course project" },
      { "command": "kalo.sendProject", "title": "Kalo: Send project to kalo.gg" },
      { "command": "kalo.signIn", "title": "Kalo: Sign in" },
      { "command": "kalo.signOut", "title": "Kalo: Sign out" }
    ],
    "configuration": {
      "title": "Kalo",
      "properties": {
        "kalo.projectsFolder": {
          "type": "string",
          "default": "",
          "description": "Where projects are set up, one folder per course and lesson. Empty means a kalo folder in your home directory."
        },
        "kalo.syncOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Send the project to your kalo.gg account after every save, once you are signed in."
        },
        "kalo.site": {
          "type": "string",
          "default": "https://kalo.gg",
          "description": "The Kalo site projects are fetched from. Only change this to develop against a local copy of Kalo."
        },
        "kalo.api": {
          "type": "string",
          "default": "https://api.kalo.gg",
          "description": "The Kalo API sign-in and project files go to. Only change this to develop against a local copy of Kalo."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.3.0",
    "typescript": "^5.5.0"
  }
}
